{
  "manifest_version": 3,
  "name": "Liquid Glass YouTube",
  "version": "1.0",
  "description": "Thêm hiệu ứng liquid glass cho giao diện YouTube",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
